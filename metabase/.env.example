# Metabase application database (MariaDB database `metabase`).
# Prefer the MariaDB Tailscale IP — MagicDNS names may not resolve inside the container.
MB_DB_HOST=100.x.y.z
MB_DB_USER=metabase_app
MB_DB_PASS=CHANGE_ME_APP

# Host publish: Tailscale IP only (not LAN). Container still listens on 3000.
# Prefer a free host port (3002+ if 3000/3001 are taken).
METABASE_BIND=100.x.y.z
METABASE_PORT=3002

# Warehouse connection is configured in Metabase Admin (UI), not here:
#   Host: same Tailscale IP as MB_DB_HOST
#   Database: mac_analytics
#   User: metabase_ro

# Metabot / Ollama on the same host as this Compose project.
# Metabase runs in Docker; Ollama must listen beyond loopback (OLLAMA_HOST=0.0.0.0:11434)
# or the container cannot reach it via host.docker.internal.
MB_LLM_ALLOWED_NETWORKS=allow-all
MB_LLM_OLLAMA_API_BASE_URL=http://host.docker.internal:11434/v1
# Leave API key unset for a local Ollama with no auth.
