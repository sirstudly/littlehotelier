# Example env for ronbot-bridge (copy to .env — never commit secrets)
# Also loads repo-root .env first; shell env wins.

WAHA_API_KEY=change-me-long-random
WAHA_SESSION=default
WAHA_BASE_URL=http://127.0.0.1:3000

# Comma-separated allowlisted staff group JIDs (preferred over config/groups.json)
# RONBOT_WHATSAPP_GROUPS=120363...@g.us,120363...@g.us

RONBOT_MENTION=@ronbot
RONBOT_FOLLOWUP_MINUTES=15

CURSOR_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=macbackpackers-backoffice
RONBOT_READ_API_URL=http://127.0.0.1:8080
RONBOT_TOKEN=
