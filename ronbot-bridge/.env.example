# Example env for ronbot-bridge (copy to .env — never commit secrets)
# Also loads repo-root .env first; shell env wins.

WAHA_API_KEY=change-me-long-random
WAHA_SESSION=default
WAHA_BASE_URL=http://127.0.0.1:3000

# Comma-separated allowlisted staff groups (preferred over config/groups.json).
# Optional :property suffix (crh|hsh|rmb|lsh) sets the default property for that group.
# RONBOT_WHATSAPP_GROUPS=120363...@g.us:hsh,120363...@g.us:lsh,120363...@g.us

# Optional text alias (also matches token "ronbot" / "@~ronbot").
# Real WhatsApp @-mentions use the bot LID — matched automatically via session me.
RONBOT_MENTION=@ronbot
RONBOT_FOLLOWUP_MINUTES=15

CURSOR_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=macbackpackers-backoffice
RONBOT_READ_API_URL=http://127.0.0.1:8080
RONBOT_TOKEN=
