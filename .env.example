# Shared token for authentication with ronbot-mcp
#RONBOT_TOKEN=some-shared-token-value

# Host port for WAHA dashboard/API (container still listens on 3000).
#WAHA_PORT=3000

# Tailscale auth key for mysql-tailscale egress (reusable, tagged, non-ephemeral).
# Create in Tailscale admin console; keep only in gitignored .env (or a password manager).
#TS_AUTHKEY=tskey-auth-...
# Distinct per host if local + production both run mysql-tailscale.
#TS_HOSTNAME=tailscale-mysql-egress

# JDBC hosts for processors / ronbot-read-api (Compose defaults these to mysql-tailscale).
# On a Tailscale-native host (no Docker egress), use MagicDNS e.g. new-mac-example.
#DB_HOST=mysql-tailscale
#SHAREDDB_HOST=mysql-tailscale
