# Shared token for authentication with ronbot-mcp
#RONBOT_TOKEN=some-shared-token-value

# Host port for WAHA dashboard/API (container still listens on 3000).
#WAHA_PORT=3000

# Host port for ronbot-read-api (container still listens on 8080).
#RONBOT_READ_API_PORT=8080

# Tailscale auth key for mysql-tailscale egress (reusable, tagged, non-ephemeral).
# Create in Tailscale admin console; keep only in gitignored .env (or a password manager).
#TS_AUTHKEY=tskey-auth-...
# Distinct per host if local + production both run mysql-tailscale.
#TS_HOSTNAME=tailscale-mysql-egress
# MySQL host MagicDNS FQDN on the tailnet
#TS_TAILNET_TARGET_FQDN=your-mysql-host.tailnet-name.ts.net

# JDBC hosts for processors / ronbot-read-api (Compose defaults these to mysql-tailscale).
# On a Tailscale-native host (no Docker egress), use that host's MagicDNS name.
#DB_HOST=mysql-tailscale
#SHAREDDB_HOST=mysql-tailscale

# ronbot-mcp ad-hoc SQL (read-only user: SELECT + SHOW VIEW on wp_*_backoffice).
# Used by Cursor locally (envFile) and forwarded by ronbot-bridge in Docker.
#RONBOT_SQL_RO_USER=readonly_user
#RONBOT_SQL_RO_PASSWORD=...
# Local Cursor only; Compose forces mysql-tailscale for ronbot-bridge.
# Defaults to host/port parsed from each property's db_url_<prop> secret.
#RONBOT_SQL_RO_HOST=your-mysql-host.tailnet-name.ts.net
#RONBOT_SQL_RO_PORT=3306
